<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <TargetName>Render-Engine-DX12</TargetName>
    <OutDir>$(MSBuildProjectDirectory)\build\dx12\$(Configuration)\bin\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\build\dx12\$(Configuration)\obj\</IntDir>
    <EnableDLSS Condition="'$(EnableDLSS)'==''">true</EnableDLSS>
  </PropertyGroup>
  <Import Project="Render-Engine.vcxproj" />
  <PropertyGroup>
    <ProjectGuid>{406E86EA-BB6E-471A-9312-166737EAFA94}</ProjectGuid>
    <TargetName>Render-Engine-DX12</TargetName>
    <OutDir>$(MSBuildProjectDirectory)\build\dx12\$(Configuration)\bin\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\build\dx12\$(Configuration)\obj\</IntDir>
    <LinkIncremental>false</LinkIncremental>
    <TargetPath>$(OutDir)$(TargetName).exe</TargetPath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)..\External_Lib\include;$(ProjectDir)src</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>RENDER_ENGINE_DX12;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <DebugInformationFormat Condition="'$(Configuration)'=='Debug'">OldStyle</DebugInformationFormat>
      <DebugInformationFormat Condition="'$(Configuration)'=='Release'">ProgramDatabase</DebugInformationFormat>
      <LanguageStandard>stdcpp20</LanguageStandard>
    </ClCompile>
    <Link>
      <OutputFile>$(OutDir)$(TargetName).exe</OutputFile>
      <LinkTimeCodeGeneration Condition="'$(Configuration)'=='Release'">UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
      <AdditionalLibraryDirectories>$(ProjectDir)..\External_Lib\lib;$(ProjectDir)..\External_Lib\build\ShaderTranslator\Release</AdditionalLibraryDirectories>
      <AdditionalDependencies>$(CoreLibraryDependencies);d3d12.lib;dxgi.lib;d3dcompiler.lib;dxguid.lib;ShaderTranslator.lib;glfw3.lib;assimp-vc143-mtd.lib;comctl32.lib</AdditionalDependencies>
    </Link>
    <PostBuildEvent><Command>if not exist "$(OutDir)assets" mkdir "$(OutDir)assets"
copy /Y "$(ProjectDir)assets\galaxy*.png" "$(OutDir)assets\" &gt;nul
if not exist "$(OutDir)assets\stellar" mkdir "$(OutDir)assets\stellar"
copy /Y "$(ProjectDir)assets\stellar\corona.png" "$(OutDir)assets\stellar\" &gt;nul
if not exist "$(OutDir)assets\ui" mkdir "$(OutDir)assets\ui"
copy /Y "$(ProjectDir)assets\ui\laboratories.png" "$(OutDir)assets\ui\" &gt;nul
copy /Y "$(ProjectDir)..\External_Lib\build\ShaderTranslator\Release\ShaderTranslator.dll" "$(OutDir)" &gt;nul
copy /Y "$(ProjectDir)..\External_Lib\lib\assimp-vc143-mtd.dll" "$(OutDir)" &gt;nul</Command></PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="src\dx12\Dx12SceneBridge.cpp" />
    <ClCompile Include="src\dx12\Dx12Dlss.cpp" />
    <ClCompile Include="src\dx12\Dx12Renderer.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="src\dx12\Dx12SceneBridge.h" />
    <ClInclude Include="src\dx12\Dx12Dlss.h" />
    <ClInclude Include="src\dx12\Dx12Renderer.h" />
    <ClInclude Include="src\dx12\ShaderTranslator.h" />
  </ItemGroup>
  <ItemDefinitionGroup Condition="'$(EnableDLSS)'=='true'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)..\External_Lib\src\DLSS\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>RENDER_ENGINE_DLSS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(ProjectDir)..\External_Lib\src\DLSS\lib\Windows_x86_64\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies Condition="'$(Configuration)'=='Debug'">nvsdk_ngx_d_dbg.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalDependencies Condition="'$(Configuration)'!='Debug'">nvsdk_ngx_d.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="DeployDlss" AfterTargets="Build" Condition="'$(EnableDLSS)'=='true'">
    <Copy SourceFiles="$(ProjectDir)..\External_Lib\src\DLSS\lib\Windows_x86_64\rel\nvngx_dlss.dll;$(ProjectDir)..\External_Lib\src\DLSS\LICENSE.txt" DestinationFolder="$(OutDir)" />
  </Target>
</Project>
